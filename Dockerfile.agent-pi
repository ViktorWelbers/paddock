# Sandbox agent image: the pi coding agent against an OpenAI-compatible
# upstream (vLLM, llama.cpp, ...) through the paddock gateway. Same contract
# as Dockerfile.agent: the entrypoint holds the pod alive, `paddock attach`
# execs `pi` with a TTY, everything is baked in at build time because the
# NetworkPolicy blocks all egress except the gateway.
#
# `age`, `gnupg`, and `openssh-client` are paddock plumbing, not developer
# toolchain: `age` decrypts the git-secret handoff so nothing crosses the
# control plane in the clear, and gnupg/ssh-keygen let the agent make signed
# commits with the developer's key (see docs/ARCHITECTURE.md, "Git credentials").
#
# pi itself is installed under /opt/pi; `pi` on PATH is a launcher that
# renders ~/.pi/agent/models.json from the sandbox env (models.json cannot
# interpolate env vars into baseUrl) before exec'ing the real binary.

# toolchain fetches pinned Go and gh binaries with curl -- curl itself must
# never reach the final image (it is on the sandbox's network_tools denylist,
# policies/sandbox_tools.rego: sanctioned egress is through governed package
# managers, not a raw HTTP client), so the download happens in this throwaway
# stage and only the resulting binaries get copied forward.
FROM debian:bookworm-slim AS toolchain
ARG GO_VERSION=1.26.4
ARG GH_VERSION=2.63.0
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" | tar -C /usr/local -xz \
 && curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.tar.gz" -o /tmp/gh.tar.gz \
 && tar -xzf /tmp/gh.tar.gz -C /tmp \
 && mv "/tmp/gh_${GH_VERSION}_linux_amd64/bin/gh" /usr/local/bin/gh

FROM node:22-bookworm-slim

ARG PI_VERSION=latest

COPY --from=toolchain /usr/local/go /usr/local/go
COPY --from=toolchain /usr/local/bin/gh /usr/local/bin/gh

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ripgrep tini procps ca-certificates \
      python3 python3-pip python3-venv make jq age gnupg openssh-client \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g --prefix /opt/pi @earendil-works/pi-coding-agent@${PI_VERSION} \
 && npm cache clean --force

COPY scripts/agent-pi-launcher.sh /usr/local/bin/pi
RUN chmod 755 /usr/local/bin/pi

RUN groupadd -g 10001 agent \
 && useradd -m -u 10001 -g 10001 -d /home/agent agent \
 && mkdir -p /workspace \
 && chown 10001:10001 /workspace

# /workspace is an emptyDir at runtime, and the kubelet creates its mount
# root owned by root (fsGroup only sets the group). Git then refuses to
# touch the developer's repo there -- "detected dubious ownership" -- even
# though every file inside belongs to the agent. The workspace is the
# agent's own by construction, so declare it trusted.
RUN git config --system --add safe.directory /workspace

# PI_OFFLINE: no update checks or other startup network calls — they can
# only hang against the sandbox NetworkPolicy.
ENV HOME=/home/agent \
    TERM=xterm-256color \
    PI_OFFLINE=1 \
    PATH="/usr/local/go/bin:${PATH}" \
    GOPATH=/home/agent/go

USER 10001:10001
WORKDIR /workspace

ENTRYPOINT ["/usr/bin/tini", "--", "sleep", "infinity"]
