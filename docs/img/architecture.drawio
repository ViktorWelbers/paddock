        </mxCell>

        <mxCell id="e1" value="CONNECT" style="endArrow=block;html=1;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sb" target="s1">
