        <mxCell id="e2" value="splice (encrypted)" style="endArrow=block;html=1;startArrow=block;startFill=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="s6" target="up">
