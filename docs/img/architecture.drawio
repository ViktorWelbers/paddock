  </diagram>

  <diagram id="flow-workspace" name="flow-workspace">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="440" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="Workspace transfer — through the server, not the CLI's cluster access" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="820" height="26" as="geometry" />
        </mxCell>

        <mxCell id="cli" value="paddock CLI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="srv" value="paddock-server&#10;pods/exec" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="180" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pod" value="sandbox&#10;/workspace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="830" y="180" width="150" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ePush1" value="push  ── tar.gz ▶" style="endArrow=block;html=1;fontSize=11;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="cli" target="srv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ePush2" value="tar -xzf - -C /workspace ▶" style="endArrow=block;html=1;fontSize=11;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="srv" target="pod">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ePull2" value="◀ tar.gz  pull" style="endArrow=block;html=1;fontSize=11;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="srv" target="cli">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ePull1" value="◀ tar -czf - -C /workspace ." style="endArrow=block;html=1;fontSize=11;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="pod" target="srv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="Streamed end to end (piped into pod stdin) · audited with bytes + sha256 both directions.&#10;Developer needs no kubeconfig and no pods/exec rights — the server holds them." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="80" y="300" width="880" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="Pull is the dangerous direction (archive built from a dir the agent could write):&#10;CLI extracts through os.Root — writes confined to the target dir at the kernel level, ../ &amp; absolute entries refused, total bytes capped." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="80" y="350" width="880" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="flow-gitcreds" name="flow-gitcreds">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="Git credentials — encrypted handoff (plaintext never transits the control plane)" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="26" as="geometry" />
        </mxCell>

        <mxCell id="cli" value="paddock CLI&#10;(developer laptop)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="360" width="190" height="120" as="geometry" />
        </mxCell>
        <mxCell id="srv" value="paddock-server&#10;(relays ciphertext only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="360" width="190" height="120" as="geometry" />
        </mxCell>
        <mxCell id="pod" value="sandbox pod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;fontStyle=1;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="870" y="300" width="220" height="290" as="geometry" />
        </mxCell>
        <mxCell id="keygen" value="age-keygen&#10;private key stays here&#10;(never leaves)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="890" y="350" width="180" height="95" as="geometry" />
        </mxCell>
        <mxCell id="decrypt" value="age -d -i key →&#10;~/.git-credentials (0600)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="890" y="465" width="180" height="95" as="geometry" />
        </mxCell>

        <!-- Step 1: public recipient travels pod -> (server) -> CLI, drawn as a clean arc over the top -->
        <mxCell id="e1" value="①  age public recipient  (CLI: GET /git-recipient)" style="endArrow=block;html=1;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pod" target="cli">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="925" y="250" />
              <mxPoint x="155" y="250" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 2: CLI encrypts to recipient, POSTs ciphertext to the server -->
        <mxCell id="e2" value="②  POST /git-credentials&#10;{ciphertext, hosts}" style="endArrow=block;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cli" target="srv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 3: server relays ciphertext into the pod, which decrypts it -->
        <mxCell id="e3" value="③  ciphertext → exec: age -d" style="endArrow=block;html=1;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="srv" target="decrypt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Pod generates an age (X25519) keypair on first ask; the server only ever handles the public recipient and the opaque ciphertext — only the pod can open it.&#10;Lands 0600 under git's store helper — not in the pod spec, not in etcd, not in the workspace. Audited by host + username, never the secret.  Opt out: --no-git-credentials." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="590" width="1030" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
